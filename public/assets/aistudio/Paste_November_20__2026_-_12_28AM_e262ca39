## 4. Shared RoboTrader-style discovery code

Use the following reconstructed JavaScript as a starting point. Integrate it into the existing `WebTerminalScripts.kt` architecture and adapt it where necessary. Do not simply paste it without testing it against the actual terminal.

This code is a BTECH implementation based on the observed RoboTrader behaviour, not a claim that the full original RoboTrader source was recovered.

```javascript
(function () {
    "use strict";

    const ALLOWED_SUFFIXES = [
        ".m", ".s", ".c", ".ecn", ".pro",
        ".raw", ".r", ".micro", ".std",
        ".cent", ".i", "_i", "#"
    ];

    function normalise(value) {
        return String(value || "")
            .trim()
            .toUpperCase();
    }

    function getRoots() {
        const roots = [document];
        const seen = new Set(roots);

        for (let i = 0; i < roots.length; i++) {
            const root = roots[i];

            let elements = [];

            try {
                elements = root.querySelectorAll("*");
            } catch (_) {
                continue;
            }

            elements.forEach(function (element) {
                if (element.shadowRoot &&
                    !seen.has(element.shadowRoot)) {
                    seen.add(element.shadowRoot);
                    roots.push(element.shadowRoot);
                }

                if (element.tagName === "IFRAME") {
                    try {
                        const frameDocument =
                            element.contentDocument;

                        if (frameDocument &&
                            !seen.has(frameDocument)) {
                            seen.add(frameDocument);
                            roots.push(frameDocument);
                        }
                    } catch (_) {
                        // Cross-origin frames cannot be inspected.
                    }
                }
            });
        }

        return roots;
    }

    function deepAll(selector) {
        const result = [];
        const seen = new Set();

        getRoots().forEach(function (root) {
            try {
                root.querySelectorAll(selector)
                    .forEach(function (element) {
                        if (!seen.has(element)) {
                            seen.add(element);
                            result.push(element);
                        }
                    });
            } catch (_) {
                // Ignore invalid or unavailable DOM roots.
            }
        });

        return result;
    }

    function isVisible(element) {
        if (!element) return false;

        try {
            const style =
                element.ownerDocument.defaultView
                    .getComputedStyle(element);

            return element.getClientRects().length > 0 &&
                style.display !== "none" &&
                style.visibility !== "hidden" &&
                style.opacity !== "0";
        } catch (_) {
            return false;
        }
    }

    function getElementText(element) {
        if (!element) return "";

        return [
            element.getAttribute("data-symbol"),
            element.getAttribute("data-name"),
            element.getAttribute("aria-label"),
            element.getAttribute("title"),
            element.textContent
        ]
        .filter(Boolean)
        .join(" ")
        .trim();
    }

    function extractSymbolTokens(value) {
        return normalise(value).match(
            /[A-Z0-9]+(?:[._#-][A-Z0-9]+)*/g
        ) || [];
    }

    function stripKnownSuffix(symbol) {
        const value = normalise(symbol);

        for (const suffix of ALLOWED_SUFFIXES) {
            if (value.endsWith(suffix) &&
                value.length > suffix.length + 2) {
                return value.slice(0, -suffix.length);
            }
        }

        // Handle common broker suffixes without
        // stripping the final character of normal six-letter pairs.
        if (value.length >= 7 && /[MC]$/.test(value)) {
            return value.slice(0, -1);
        }

        return value;
    }

    function matchRank(actual, requested) {
        const a = normalise(actual);
        const r = normalise(requested);

        if (!a || !r) return 0;

        // Exact match always wins.
        if (a === r) return 3;

        // Only allow a suffix match when the base is identical.
        if (stripKnownSuffix(a) === stripKnownSuffix(r)) {
            return 1;
        }

        return 0;
    }

    function findSymbolElement(requestedSymbol) {
        const selectors = [
            "[data-symbol]",
            "[role='option']",
            "[role='row']",
            "tr",
            "li",
            "button",
            "[class*='symbol']",
            "[class*='Symbol']"
        ];

        const elements = deepAll(selectors.join(","));

        const matches = [];

        elements.forEach(function (element) {
            if (!isVisible(element)) return;

            const tokens = extractSymbolTokens(
                getElementText(element)
            );

            let bestRank = 0;
            let actualSymbol = null;

            tokens.forEach(function (token) {
                const rank = matchRank(
                    token,
                    requestedSymbol
                );

                if (rank > bestRank) {
                    bestRank = rank;
                    actualSymbol = token;
                }
            });

            if (bestRank > 0) {
                matches.push({
                    element: element,
                    actualSymbol: actualSymbol,
                    matchRank: bestRank,
                    textLength: (element.textContent || "").length
                });
            }
        });

        // Prefer exact match, then the smallest matching element.
        matches.sort(function (a, b) {
            if (b.matchRank !== a.matchRank) {
                return b.matchRank - a.matchRank;
            }

            return a.textLength - b.textLength;
        });

        return matches.length ? matches[0] : null;
    }

    function getClickableElement(element) {
        if (!element) return null;

        return element.closest(
            "button, a, [role='button'], [role='option'], " +
            "[role='row'], tr, li, [data-symbol], " +
            "[class*='row'], [class*='item']"
        ) || element;
    }

    function clickElement(element) {
        if (!element || !isVisible(element)) {
            return false;
        }

        try {
            getClickableElement(element).click();
            return true;
        } catch (_) {
            return false;
        }
    }

    function setNativeInputValue(input, value) {
        if (!input) return false;

        try {
            const view = input.ownerDocument.defaultView;
            const prototype = input.tagName === "TEXTAREA"
                ? view.HTMLTextAreaElement.prototype
                : view.HTMLInputElement.prototype;

            const descriptor =
                Object.getOwnPropertyDescriptor(
                    prototype,
                    "value"
                );

            if (descriptor && descriptor.set) {
                descriptor.set.call(input, value);
            } else {
                input.value = value;
            }

            input.dispatchEvent(
                new view.Event("input", { bubbles: true })
            );

            input.dispatchEvent(
                new view.Event("change", { bubbles: true })
            );

            return true;
        } catch (_) {
            return false;
        }
    }

    function wait(milliseconds) {
        return new Promise(function (resolve) {
            setTimeout(resolve, milliseconds);
        });
    }

    async function waitForSymbol(symbol, timeoutMs) {
        const start = Date.now();

        while (Date.now() - start < timeoutMs) {
            const result = findSymbolElement(symbol);

            if (result) return result;

            await wait(250);
        }

        return null;
    }

    window.BtechRoboTraderDiscovery = {
        findSymbolElement: findSymbolElement,
        matchRank: matchRank,
        normalise: normalise,
        waitForSymbol: waitForSymbol
    };
})();
```

## 5. MT5 discovery implementation

Add a separate MT5 discovery function using the following approach.

```javascript
async function discoverMT5Symbol(targetSymbol) {
    const requested = String(targetSymbol || "").trim();

    if (!requested) {
        return {
            success: false,
            platform: "MT5",
            error: "No symbol was supplied"
        };
    }

    const searchSelectors = [
        "input[placeholder*='Search symbol' i]",
        "input[aria-label*='Search symbol' i]",
        "input[placeholder*='search' i]",
        "input[aria-label*='search' i]",
        "input[type='search']"
    ];

    let searchInput = null;

    for (const selector of searchSelectors) {
        searchInput = deepAll(selector).find(isVisible);

        if (searchInput) break;
    }

    if (!searchInput) {
        return {
            success: false,
            platform: "MT5",
            error: "MT5 symbol search field not found"
        };
    }

    if (!setNativeInputValue(searchInput, requested)) {
        return {
            success: false,
            platform: "MT5",
            error: "Could not enter symbol in MT5 search field"
        };
    }

    const result = await waitForSymbol(requested, 6000);

    if (!result) {
        return {
            success: false,
            platform: "MT5",
            error: "error:Symbol " + requested + " not found"
        };
    }

    const clicked = clickElement(result.element);

    if (!clicked) {
        return {
            success: false,
            platform: "MT5",
            error: "MT5 symbol result could not be selected",
            actualSymbol: result.actualSymbol
        };
    }

    return {
        success: true,
        platform: "MT5",
        requestedSymbol: requested,
        actualSymbol: result.actualSymbol,
        matchRank: result.matchRank,
        resultClicked: true,
        message: "Matching MT5 symbol selected; verify the active instrument before trading"
    };
}
```

Integrate this with the existing BTECH WebView script and existing deep-DOM utilities. If the existing `WebTerminalScripts.kt` already supplies helpers such as `collectRoots`, `queryDeepAll`, `isVisible`, `setNativeValue` and `realClick`, reuse them instead of maintaining unnecessary duplicate implementations.

The MT5 function must not report a successful trade just because a search result was clicked. It must pass the selected instrument to the next stage, which verifies the active instrument and order ticket.

## 6. MT4 discovery implementation

Add an independent MT4 function following the observed Market Watch workflow.

```javascript
function findExactVisibleText(text, selectors) {
    const wanted = String(text || "")
        .trim()
        .toLowerCase();

    const elements = deepAll(selectors);

    return elements.find(function (element) {
        return isVisible(element) &&
            (element.textContent || "")
                .trim()
                .toLowerCase() === wanted;
    }) || null;
}

function openMT4ContextMenu(target) {
    if (!target) return false;

    try {
        const view = target.ownerDocument.defaultView;

        target.dispatchEvent(
            new view.MouseEvent("contextmenu", {
                bubbles: true,
                cancelable: true,
                view: view,
                button: 2,
                buttons: 2
            })
        );

        return true;
    } catch (_) {
        return false;
    }
}

function doubleClickMT4Row(element) {
    if (!element || !isVisible(element)) return false;

    const target = getClickableElement(element);

    try {
        const view = target.ownerDocument.defaultView;

        function mouseEvent(type, detail) {
            target.dispatchEvent(
                new view.MouseEvent(type, {
                    bubbles: true,
                    cancelable: true,
                    view: view,
                    button: 0,
                    buttons: type === "mouseup" ? 0 : 1,
                    detail: detail
                })
            );
        }

        mouseEvent("mousedown", 1);
        mouseEvent("mouseup", 1);
        mouseEvent("click", 1);

        mouseEvent("mousedown", 2);
        mouseEvent("mouseup", 2);
        mouseEvent("click", 2);

        mouseEvent("dblclick", 2);

        return true;
    } catch (_) {
        return false;
    }
}

async function discoverMT4Symbol(targetSymbol) {
    const requested = String(targetSymbol || "").trim();

    if (!requested) {
        return {
            success: false,
            platform: "MT4",
            error: "No symbol was supplied"
        };
    }

    // First check whether the symbol is already visible.
    let result = findSymbolElement(requested);

    // Locate the Market Watch section.
    const marketWatchLabel = findExactVisibleText(
        "Market Watch",
        "div, span, button, label, [role='heading']"
    );

    let marketWatchPanel = marketWatchLabel;

    // Move up the DOM to identify its panel/container.
    for (let i = 0; i < 5 && marketWatchPanel; i++) {
        if (marketWatchPanel.querySelectorAll) {
            const panelText =
                (marketWatchPanel.textContent || "")
                    .toLowerCase();

            if (panelText.includes("market watch")) {
                break;
            }
        }

        marketWatchPanel = marketWatchPanel.parentElement;
    }

    // If not found, open the Market Watch context menu
    // and activate the actual visible Show All option.
    if (!result) {
        if (!marketWatchPanel) {
            return {
                success: false,
                platform: "MT4",
                error: "MT4 Market Watch panel not found"
            };
        }

        openMT4ContextMenu(marketWatchPanel);
        await wait(300);

        const showAll = findExactVisibleText(
            "Show All",
            "[role='menuitem'], button, li, span, div"
        );

        if (!showAll) {
            return {
                success: false,
                platform: "MT4",
                error: "MT4 Show All menu option not found"
            };
        }

        if (!clickElement(showAll)) {
            return {
                success: false,
                platform: "MT4",
                error: "Could not activate MT4 Show All"
            };
        }

        await wait(800);

        result = await waitForSymbol(requested, 6000);
    }

    if (!result) {
        return {
            success: false,
            platform: "MT4",
            error: "error:Symbol " + requested + " not found"
        };
    }

    const opened = doubleClickMT4Row(result.element);

    if (!opened) {
        return {
            success: false,
            platform: "MT4",
            error: "Could not open the MT4 instrument row",
            actualSymbol: result.actualSymbol
        };
    }

    return {
        success: true,
        platform: "MT4",
        requestedSymbol: requested,
        actualSymbol: result.actualSymbol,
        matchRank: result.matchRank,
        doubleClickSent: true,
        message: "Matching MT4 Market Watch row selected; verify the order ticket before trading"
    };
}
```

Integrate the MT4 function into the shared discovery module. Do not let MT4 fall back to the MT5 search-field method simply because its own discovery failed.

The context-menu and double-click operations must be tested against the real Web Terminal. If a browser or terminal rejects synthetic mouse events, implement a compatible interaction using the existing BTECH WebView helpers and report the limitation rather than pretending the interaction worked.

## 7. Broker symbol matching and discovery

Improve the existing BTECH symbol resolver.

The current app already has symbol suffix logic, including examples such as:

- `XAUUSD`
- `XAUUSDm`
- `XAUUSD.m`
- `XAUUSD.s`
- `XAUUSD.c`
- `XAUUSD.ecn`
- `XAUUSD.pro`
- `XAUUSD.raw`
- `XAUUSD_i`

Retain useful existing logic, but make the resolution broker-aware.

Resolution priority:

1. Exact match.
2. Case-insensitive exact match.
3. Exact instrument discovered from the broker's terminal.
4. Explicit broker-specific alias configured and verified.
5. Recognised suffix variation with the same underlying symbol.
6. Report not found.

Do not assume `GOLD` is always the same instrument as `XAUUSD`. Only accept such an alias where the broker's actual instrument configuration verifies the relationship.

Never choose a similar-looking instrument just to make a signal execute.

Use a clear result model, adapted to the existing BTECH models:

```kotlin
data class SymbolDiscoveryRequest(
    val requestedSymbol: String,
    val broker: String,
    val platform: PlatformType,
    val server: String
)

data class SymbolDiscoveryResult(
    val success: Boolean,
    val requestedSymbol: String,
    val actualBrokerSymbol: String?,
    val broker: String,
    val platform: PlatformType,
    val server: String,
    val matchType: String,
    val message: String
)
```

Use the existing `PlatformType` definition rather than creating a conflicting second platform enum.

## 8. Make discovery dynamic

Do not restrict the engine to the short hardcoded list of common currency pairs and metals.

Discover instruments actually offered by the connected broker and account, including where available:

- Forex pairs.
- Gold and silver.
- Stock-market indices.
- Energies and commodities.
- Cryptocurrencies.
